source "https://rubygems.org"

# GitHub Pages uses this gem — it pins Jekyll and plugins to the versions
# GitHub actually runs, so what you see locally matches what goes live.
gem "github-pages", group: :jekyll_plugins

gem "webrick", "~> 1.8"   # needed on Ruby 3+ for `jekyll serve`

group :jekyll_plugins do
  gem "jekyll-feed"
  gem "jekyll-seo-tag"
  gem "jekyll-sitemap"
end
